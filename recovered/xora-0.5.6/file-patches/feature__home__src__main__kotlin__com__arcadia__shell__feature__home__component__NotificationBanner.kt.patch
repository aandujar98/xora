+/**
+ * Your own unlock on the same card as a friend's, so the two read as one family. The badge is the
+ * picture here — there is no second face to show — and the achievement's name sits under it.
+ */
+@Composable
+private fun OwnTrophyBanner(
+    notification: ShellNotification.AchievementUnlocked,
+    onDismiss: () -> Unit,
+    onActivate: ((ShellNotification) -> Unit)?,
+    modifier: Modifier = Modifier,
+) {
+    val subtitle = listOfNotNull(
+        notification.points?.takeIf { it > 0 }?.let { "$it pts" },
+        notification.gameTitle?.trim()?.takeIf { it.isNotEmpty() },
+    ).joinToString(" · ")
+    TrophyBanner(
+        headline = notification.title,
+        leadingUrl = notification.badgeUrl,
+        leadingFallback = "RA",
+        badgeUrl = null,
+        title = subtitle.ifBlank { if (notification.hardcore) "Hardcore" else "Achievement unlocked" },
+        onClick = {
+            if (onActivate != null) onActivate(notification)
+            onDismiss()
+        },
+        modifier = modifier,
+    )
+}
+
