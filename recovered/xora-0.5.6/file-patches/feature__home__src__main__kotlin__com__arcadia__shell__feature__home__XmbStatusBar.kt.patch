+
+/** Charging lights the cells green; a flat battery reds them; otherwise they are plain white. */
+internal fun batteryFillColor(percent: Int, charging: Boolean): Color = when {
+    charging -> BatteryChargingGreen
+    percent > 20 -> Color.White
+    else -> Color(0xFFFF5C6C)
+}
+
+internal val BatteryChargingGreen = Color(0xFF5BE37D)
